# URL pública de la API (la usa el navegador)
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1
# URL de la API desde el servidor de Next (en Docker: http://api:4000/api/v1). Opcional.
API_URL=
# Negocio que muestra esta web (slug del negocio en la API)
# Marca de la plataforma (la página principal y los correos propios)
NEXT_PUBLIC_PLATFORM_NAME=FILO
# Dominio público de la web (SEO: canonical, sitemap, Open Graph)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
